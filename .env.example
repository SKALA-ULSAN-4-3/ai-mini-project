# 프로젝트 루트에 .env로 복사합니다. 기존 .env를 덮어쓰지 마세요.
DATA_GO_KR_SERVICE_KEY=
# 개찰결과·재입찰 조회: 조달청_나라장터 낙찰정보서비스 전용 Decoding 키
DATA_GO_KR_SCSBID_SERVICE_KEY=
OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 입찰 파이프라인: 기본값. API 키는 위 OPENAI_API_KEY를 사용합니다.
BID_EMBEDDING_MODEL=text-embedding-3-small
# RAG 서버(2번): 4번 Java 백엔드 주소. 설정하면 /bids · /score · /checklist가 로그인 토큰으로 회사 프로필을 받아 동작합니다.
BACKEND_URL=http://localhost:8080

# Java 백엔드와 동일한 서버 간 문서 저장 키. 값은 커밋하지 않습니다.
SERVICE_API_KEY=
# 문서 변환: 파일별 120초, 시간 초과 시 최대 2회 시도. 전체 상한은 900초입니다.
BID_CONVERSION_TIMEOUT_SECONDS=120
BID_CONVERSION_MAX_ATTEMPTS=2
BID_PREPARE_TIMEOUT_SECONDS=900
