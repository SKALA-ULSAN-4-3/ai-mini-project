# 서버 연결 방식 (바꾼 뒤에는 npm run dev 를 껐다 다시 켜세요)
#   me      : 4번 선택·승인(/me/...)만 가짜, 나머지는 진짜 서버   ← 지금 권장 (develop 에 1번·4번 API 가 합쳐짐)
#   partial : 1번(검색·적재·작업)과 4번(/me/...) 모두 가짜 (1번 서버가 없을 때)
#   true    : 전부 가짜 (서버가 하나도 없어도 화면 전체를 볼 수 있음)
#   false   : 전부 진짜 서버 (4번 /me/... 까지 완성된 뒤)
VITE_USE_MOCK=me
