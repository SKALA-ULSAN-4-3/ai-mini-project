# 서버
SERVER_PORT=8080

# MariaDB
# 로컬 포트 포워딩 또는 로컬 DB에서 사용하는 주소입니다.
# Kubernetes 내부에서는 jdbc:mariadb://ai-mini-mariadb:3306/sql_db를 사용합니다.
DB_URL=jdbc:mariadb://localhost:53301/sql_db
DB_USER=root
DB_PASSWORD=replace-database-password

# Java 서버가 발급하고 RAG 서비스가 검증할 공통 JWT 설정
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=simple-auth-server
JWT_EXPIRATION_SECONDS=3600

# API 요청을 허용할 프론트 주소
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8008,http://127.0.0.1:8008
