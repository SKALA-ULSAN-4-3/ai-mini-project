# 서버
SERVER_PORT=8080

# PostgreSQL
# 로컬 Docker PostgreSQL에 접속하는 기본 주소입니다. Aiven에서는 Console의
# Host, Port, Database 값을 사용하고 sslmode=require를 유지합니다.
DB_URL=jdbc:postgresql://localhost:54321/workplace_db
DB_USER=workplace_app
DB_PASSWORD=replace-database-password

# Java 서버가 발급하고 RAG 서비스가 검증할 공통 JWT 설정
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=simple-auth-server
JWT_EXPIRATION_SECONDS=3600

# API 요청을 허용할 프론트 주소
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8008,http://127.0.0.1:8008
