# 서버
SERVER_PORT=8080

# Aiven PostgreSQL
# Aiven Console의 Host와 Port를 입력하고, 암호화 연결을 위해 sslmode=require를 유지합니다.
DB_URL=jdbc:postgresql://<aiven-host>:<aiven-port>/defaultdb?sslmode=require
DB_USER=avnadmin
DB_PASSWORD=replace-database-password

# Java 서버가 발급하고 RAG 서비스가 검증할 공통 JWT 설정
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=simple-auth-server
JWT_EXPIRATION_SECONDS=3600

# API 요청을 허용할 프론트 주소
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8008,http://127.0.0.1:8008

# 데이터 파이프라인·RAG 서비스가 X-Service-Key 헤더로 보내는 서버 간 인증 키(쓰기 API용)
SERVICE_API_KEY=replace-with-a-long-random-key

# 공고 원본 PDF를 보관하는 Supabase Storage (비공개 버킷). 비워 두면 문서 API만 503을 돌려줍니다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-or-secret-key
SUPABASE_BUCKET=documents
