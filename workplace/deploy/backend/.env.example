# 교육용 클러스터에서 허용받은 Namespace를 사용합니다.
K8S_NAMESPACE=class-4

# 빌드 후 Registry에 올린 실제 이미지 주소로 변경해야 합니다.
BACKEND_IMAGE=CHANGE_ME/workplace-backend:latest

# Aiven PostgreSQL의 Connection information에서 확인한 값입니다.
DB_URL='jdbc:postgresql://replace-host:replace-port/defaultdb?sslmode=require'
DB_USER=replace-database-user
DB_PASSWORD='replace-database-password'

# 브라우저에서 백엔드 API를 호출할 프론트엔드 Origin 목록입니다.
# 실제 배포 주소가 정해지면 HTTPS 주소를 쉼표로 구분하여 추가합니다.
CORS_ORIGINS=http://localhost:5174,http://localhost:8008

# openssl rand -hex 64 등으로 새 값을 생성합니다.
JWT_SECRET='replace-with-a-long-random-secret'
JWT_ISSUER=simple-auth-server
JWT_EXPIRATION_SECONDS=3600
