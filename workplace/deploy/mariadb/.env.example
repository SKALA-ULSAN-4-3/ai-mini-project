# 이 파일을 .env로 복사한 뒤 실제 비밀번호로 변경합니다.
# .env는 workplace/.gitignore 규칙에 의해 Git에 포함되지 않습니다.

# Helm release와 Kubernetes namespace입니다.
K8S_NAMESPACE=ai-mini-project
MARIADB_RELEASE_NAME=ai-mini-mariadb

# 아래 값은 예시이므로 반드시 서로 다른 강력한 비밀번호로 변경합니다.
# 특수문자가 포함되면 작은따옴표로 감싸는 것이 안전합니다.
MARIADB_ROOT_PASSWORD='replace-with-root-password'
MARIADB_APP_PASSWORD='replace-with-app-password'
MARIADB_REPLICATION_PASSWORD='replace-with-replication-password'
